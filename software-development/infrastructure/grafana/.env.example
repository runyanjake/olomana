# Copy to .env and fill in. Docker Compose reads .env automatically.

# Public hostname Traefik routes to the Prometheus UI
PROMETHEUS_HOST=prometheus.whitney.rip

# Basic auth for the Prometheus UI, in htpasswd format (user:bcrypt-hash).
# Generate with: htpasswd -nbB admin 'your-password'
# Keep the single quotes so Compose doesn't treat the $ in the hash as variables.
PROMETHEUS_BASIC_AUTH='admin:$2y$05$replace_with_generated_hash'
